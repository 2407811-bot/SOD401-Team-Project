<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMPUSPULSE"
            android:textColor="#4338CA"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Create an Event"
            android:textColor="#172554"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Add an event for your campus community."
            android:textColor="#64748B"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="#E5EAF5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Event title *"
                    android:textSize="14sp"
                    android:textColor="#334155"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etEventTitle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_oval_input"
                    android:hint="e.g. Student Innovation Day"
                    android:textSize="14sp"
                    android:inputType="textCapSentences"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="#172554"
                    android:textColorHint="#94A3B8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Description *"
                    android:textColor="#334155"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etEventDescription"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="7dp"
                    android:gravity="top|start"
                    android:textSize="14sp"
                    android:hint="What will happen at this event?"
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="12dp"
                    android:textColor="#172554"
                    android:textColorHint="#94A3B8"
                    android:background="@drawable/bg_oval_input" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Event date *"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etEventDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:hint="Select event date"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:textSize="14sp"
                    android:inputType="none"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="#172554"
                    android:textColorHint="#94A3B8"
                    android:background="@drawable/bg_oval_input"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:drawablePadding="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Start time *"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etEventTime"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:hint="Select event time"
                    android:focusable="false"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:inputType="none"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="#172554"
                    android:textColorHint="#94A3B8"
                    android:background="@drawable/bg_oval_input"
                    android:drawableEnd="@android:drawable/ic_lock_idle_alarm"
                    android:drawablePadding="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Location *"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etEventLocation"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:hint="e.g. Main Campus"
                    android:inputType="textCapSentences"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="#172554"
                    android:textColorHint="#94A3B8"
                    android:background="@drawable/bg_oval_input" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveEvent"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="26dp"
                    android:text="Save Event"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#4338CA"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelEvent"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="#4338CA"
                    app:backgroundTint="#EEF2FF"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="YOUR CAMPUS. YOUR COMMUNITY. YOUR MOMENT."
            android:textColor="#91A0B3"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

    </LinearLayout>
</ScrollView>
