<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F4F7FB"
    android:padding="32dp">

    <!-- CAMPUSPULSE LOGO -->
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:contentDescription="CampusPulse Logo"
        android:src="@drawable/ic_campuspulse_logo" />

    <!-- APP NAME -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="CampusPulse"
        android:textColor="#000000"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- TAGLINE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Your Campus. Your Community.&#10;Stay Connected."
        android:textColor="#000000"
        android:textSize="18sp" />

    <!-- TIME / HOURGLASS -->
    <TextView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="28dp"
        android:background="#E3F2FD"
        android:gravity="center"
        android:text="⌛"
        android:textSize="38sp" />

    <!-- LOADING MESSAGE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Loading CampusPulse..."
        android:textColor="#000000"
        android:textSize="16sp" />

    <!-- LOADING BAR -->
    <ProgressBar
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="18dp"
        android:indeterminate="true" />

</LinearLayout>