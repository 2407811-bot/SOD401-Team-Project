<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#EAF4FD"
    android:padding="24dp">

    <!-- MAIN WHITE CARD -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="30dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="32dp">

            <!-- BRAND LABEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E3F2FD"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="YOUR CAMPUS, CONNECTED"
                android:textColor="#1565C0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- LOGO -->
            <ImageView
                android:layout_width="145dp"
                android:layout_height="145dp"
                android:layout_marginTop="24dp"
                android:contentDescription="CampusPulse campus and notification logo"
                android:src="@drawable/ic_campuspulse_logo"
                android:scaleType="fitCenter" />

            <!-- APP NAME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="CampusPulse"
                android:textColor="#0D47A1"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <!-- ACCENT LINE -->
            <View
                android:layout_width="54dp"
                android:layout_height="4dp"
                android:layout_marginTop="14dp"
                android:background="#64B5F6" />

            <!-- TAGLINE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Your Campus. Your Community."
                android:textColor="#37474F"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Stay informed. Discover events.\nConnect with your campus."
                android:textColor="#78909C"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />

            <!-- LOADING SECTION -->
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="180dp"
                android:layout_height="5dp"
                android:layout_marginTop="34dp"
                android:indeterminate="true"
                android:indeterminateTint="#42A5F5"
                android:progressTint="#42A5F5"
                android:backgroundTint="#D6E9FA" />

            <!-- LOADING MESSAGE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Preparing your campus experience..."
                android:textColor="#607D8B"
                android:textSize="13sp" />
            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginTop="12dp"
                android:contentDescription="CampusPulse loading sand clock"
                android:src="@drawable/sand_clock"
                android:scaleType="fitCenter" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- BOTTOM FOOTER -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:gravity="center"
        android:text="EVENTS  •  NOTICES  •  COMMUNITY"
        android:textColor="#547A9C"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />

</LinearLayout>
