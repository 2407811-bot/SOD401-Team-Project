    ```xml
    <?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F5F7FA"
    android:padding="32dp">

    <!-- CAMPUSPULSE LOGO -->
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:contentDescription="CampusPulse Logo"
        android:src="@drawable/ic_campuspulse_logo" />

    <!-- APP NAME -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="CampusPulse"
        android:textColor="#1A237E"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- TAGLINE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Your Campus. Your Community.\nStay Connected."
        android:textColor="#757575"
        android:textSize="17sp" />

    <!-- TIME / HOURGLASS CIRCLE -->
    <TextView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/circle_background"
        android:gravity="center"
        android:text="⌛"
        android:textSize="36sp"
        android:textColor="#00BCD4" />

    <!-- LOADING MESSAGE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Loading CampusPulse..."
        android:textColor="#212121"
        android:textSize="16sp" />

    <!-- LOADING BAR -->
    
</LinearLayout>``