<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- HEADER BOX -->

        <!-- WELCOME BOX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/home_header_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="YOUR CAMPUS, CONNECTED"
                    android:textColor="#12355B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="CampusPulse"
                    android:textColor="#12355B"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Everything happening on campus."
                    android:textColor="#234B70"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/homeProfileAvatar"
                android:layout_width="69dp"
                android:layout_height="94dp"
                android:background="@drawable/bg_oval_input"
                android:gravity="center"
                android:text="CP"
                android:textColor="#1565C0"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- LOGOUT BUTTON -->
            <ImageButton
                android:id="@+id/btnHomeLogout"
                android:layout_width="65dp"
                android:layout_height="90dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Logout"
                android:padding="10dp"
                android:src="@drawable/ic_logout"
                android:text=" Logout"
                app:tint="#12355B" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/profile_header_gradient"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/profile_header_gradient"
                android:orientation="vertical"
                android:padding="22dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome to CampusPulse!"
                    android:textColor="#12355B"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Discover events, stay updated with announcements, and connect with your campus community."
                    android:textColor="#234B70"
                    android:textSize="14sp"
                    android:visibility="visible" />

            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>

        <!-- QUICK ACCESS BOX -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#E3F2FD"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#D0E4F7"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quick Access"
                    android:textColor="#12355B"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choose a section to get started."
                    android:textColor="#56738F"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- SEARCH BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_oval_input"
            android:paddingStart="18dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search campus events..."
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#12355B"
                android:textColorHint="#78909C"
                android:textSize="14sp"
                android:inputType="text" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search"
                android:layout_marginStart="10dp"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <!-- FIRST ROW OF FEATURE BOXES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <!-- CAMPUS EVENTS BOX -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnEvents"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#E1ECF7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_feature_box">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:background="@drawable/bg_feature_box"
                        android:text="📅"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Campus Events"
                        android:textColor="#12355B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Discover upcoming events."
                        android:textColor="#78909C"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ANNOUNCEMENTS BOX -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAnnouncements"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#E1ECF7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_feature_box">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:background="@drawable/bg_feature_box"
                        android:text="📢"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Announcements"
                        android:textColor="#12355B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Read important campus news."
                        android:textColor="#78909C"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- SECOND ROW OF FEATURE BOXES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- MY PROFILE BOX -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnProfile"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#E1ECF7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_feature_box">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:background="@drawable/bg_feature_box"
                        android:text="👤"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="My Profile"
                        android:textColor="#12355B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="View your personal details."
                        android:textColor="#78909C"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- EXPLORE CAMPUS BOX -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnExploreCampus"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#E1ECF7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_feature_box">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:background="@drawable/bg_feature_box"
                        android:text="🗺️"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Explore Campus"
                        android:textColor="#12355B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Explore your campus community."
                        android:textColor="#78909C"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- FOOTER BOX -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#E3F2FD"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#D0E4F7"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="18dp"
                android:text="MADE FOR YOUR CAMPUS COMMUNITY"
                android:textColor="#56738F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
