<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="18dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#D9E2EC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="724dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- EVENT TITLE -->
        <TextView
            android:id="@+id/tvEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="Student Innovation Day"
            android:textColor="#12355B"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- EVENT DESCRIPTION -->
        <TextView
            android:id="@+id/tvEventDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="5dp"
            android:text="Campus event for students and the university community."
            android:textColor="#607D8B"
            android:textSize="21sp"
            android:visibility="visible" />

        <!-- EVENT DETAILS -->
        <TextView
            android:id="@+id/tvEventDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="📍 Main Campus • 10:00 AM"
            android:textColor="#455A64"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <!-- VIEW EVENT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="VIEW EVENT  ›"
            android:textColor="#1565C0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>